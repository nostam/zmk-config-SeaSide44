#include "SeaSide44.dtsi"
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
};

/* キーマトリクスの設定 */
// 上が外側、下が内側カラムcol番号と実際の配置が直感と逆になってる
&kscan0 {
        col-gpios
            = <&gpio1 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

/* Trackball のリスナー */ 
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        // input-processors = <&zip_temp_layer 1 600>;

        scroller {
            layers = <5>;
            input-processors = <&zip_xy_to_scroll_mapper &zip_scroll_scaler 1 12 &zip_scroll_transform INPUT_TRANSFORM_X_INVERT>;
        };
    };

    behaviors {
        cpi: cpi {
            compatible = "zmk,behavior-sensor-attr-cycle";
            label = "CPI";
            #binding-cells = <1>;
            sensor_device = <&trackball>;
            attr = <0>;
            values = <600 800 1000 1200 1400 1600 200 400>;
            persistant;
            load_delay = <3000>;
        };
    };
};

// &zip_temp_layer {
//     excluded-positions = <18 19 21 22 31>;
// };

/* SPI 設定 */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

/* シリアルを無効化 */
&xiao_serial { status = "disabled"; };

/* SPI デバイス (トラックボール) */
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // automouse-layer = <4>; //ここをコメントアウトするとオートマウスレイヤーがオフになる
        // scroll-layers = <5>;
        cpi = <600>;
        invert-y;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

