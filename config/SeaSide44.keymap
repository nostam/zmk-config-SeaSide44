#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define AML 1
#define LOWER 2
#define SYM 3
#define GAME 4
#define MOUSE 5

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

/ {
    macros {
        meta_tap: meta_tap {
            compatible = "zmk,behavior-macro";
            label = "META_TAP";
            #binding-cells = <0>;
            bindings = <&kp LGUI>;
        };
    };

    behaviors {
        meta_esc: meta_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "META_ESC";
            #binding-cells = <2>;
            bindings = <&meta_tap>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB             &kp Q     &kp W     &kp E      &kp R          &kp T                    &kp Y      &kp U       &kp I        &kp O    &kp P           &kp DEL
&meta_esc 0 ESC     &kp A     &kp S     &kp D      &kp F          &kp G                    &kp H      &kp J       &lt MOUSE K  &kp L    &lt SYM SEMI    &kp SQT
&kp LSHFT           &kp Z     &kp X     &kp C      &kp V          &kp B                    &kp N      &kp M       &kp COMMA    &kp DOT  &kp FSLH        &kp BSPC
                    &lt MOUSE INS  &kp LALT  &kp LCTRL  &lt LOWER SPACE  &lt SYM LANG1     &kp RSHFT  &lt LOWER RET                                   &kp RCTRL
            >;
        };

        aml_layer {
            display-name = "AML";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans             &trans    &trans    &trans  &trans    &tog GAME  &trans
&trans  &trans  &trans  &trans  &trans  &trans             &mkp MB4  &mkp MB1  &trans  &mkp MB2  &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans             &trans    &mkp MB3  &trans  &trans    &trans     &trans
                &trans  &trans  &trans  &trans  &trans     &trans    &trans                                 &trans
            >;
        };

        lower_layer {
            display-name = "Num";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5             &kp F6    &kp F7    &kp F8    &kp F9     &kp F10    &kp F11
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0             &kp HOME  &kp PG_DN &kp PG_UP &kp END    &kp LC(C)  &kp LC(V)
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5             &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp LC(X)  &kp F12
                &trans  &trans  &trans  &trans  &trans     &trans    &trans                                    &kp RCTRL
            >;
        };

        symbol_layer {
            display-name = "Sym";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT        &kp CARET  &kp AMPS  &kp STAR  &kp PLUS  &none      &kp DEL
&trans  &kp GRAVE  &kp PIPE   &kp LBRC  &kp LPAR  &kp LBKT         &kp COLON  &kp EQUAL &kp MINUS &kp PLUS  &kp COLON  &kp SQT
&trans  &kp TILDE  &kp QMARK  &kp RBRC  &kp RPAR  &kp RBKT         &kp UNDER  &kp BSLH  &kp LT    &kp GT    &kp QMARK  &kp BSPC
                   &trans     &trans    &trans    &trans  &trans   &trans     &trans                                   &trans
            >;
        };

        game_layer {
            display-name = "Game";
            bindings = <
&kp TAB    &kp Q   &kp W   &kp E   &kp R          &kp T              &kp F1  &kp F2  &none      &none  &none  &kp DEL
&kp LCTRL  &kp A   &kp S   &kp D   &kp F          &kp G              &kp F3  &kp F4  &mo MOUSE  &none  &none  &kp N1
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V          &kp B             &kp N   &kp M   &tog GAME  &none  &none  &kp BSPC
                   &kp N1  &kp N2  &kp N3         &kp SPACE  &kp ESC &trans  &trans                             &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &bt BT_SEL 0  &none        &bt BT_CLR  &none   &none                &trans     &trans    &trans     &trans    &trans    &trans
&trans  &bt BT_SEL 1  &none        &cpi 1      &none   &none                &mkp MB4   &mkp MB1  &trans     &mkp MB2  &mkp MB5  &trans
&trans  &bt BT_SEL 2  &none        &cpi 7      &none   &kp PSCRN            &kp PSCRN  &mkp MB3  &tog GAME  &trans    &trans    &trans
                      &trans       &bootloader &trans  &trans     &none     &none      &trans                                     &bootloader
            >;
        };
    };
};
